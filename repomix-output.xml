                        </div>

                        <!-- ★ 送信先選択 セグメントタブ -->
                        <div class="target-segmented-tabs">
                            <button id="btn-target-tab-devices" class="target-tab-btn active" type="button">
                                <span class="material-symbols-outlined">devices</span> マイデバイス
                            </button>
                            <button id="btn-target-tab-room" class="target-tab-btn" type="button">
                                <span class="material-symbols-outlined">link</span> 合言葉・共有リンク
                            </button>
                        </div>

                        <!-- 1. マイデバイスパネル -->
                        <div id="target-panel-devices" class="target-panel-content">
                            <div id="device-chip-list" class="device-chip-list">
                                <span class="no-device-text">他デバイスを検索中...</span>
                            </div>
                        </div>

                        <!-- 2. 合言葉・共有リンクパネル -->
                        <div id="target-panel-room" class="target-panel-content hidden">
                            <div class="room-action-container">
                                <!-- 共有リンク発行セクション -->
                                <div class="room-section-box">
                                    <div class="room-section-header">
                                        <span class="material-symbols-outlined">share</span>
                                        <span>方法1: ワンタップ共有リンクを発行</span>
                                    </div>
                                    <p class="room-section-desc">発行されたリンクを開くだけで、相手と即座にP2P接続できます</p>
                                    <button id="btn-create-room" class="m3-button btn-primary-sm full-width" type="button">
                                        <span class="material-symbols-outlined">add_link</span> 共有URLを発行してコピー
                                    </button>
                                </div>

                                <div class="room-divider-badge"><span>または (OR)</span></div>

                                <!-- 合言葉接続セクション -->
                                <div class="room-section-box">
                                    <div class="room-section-header">
                                        <span class="material-symbols-outlined">key</span>
                                        <span>方法2: 合言葉を入力して接続</span>
                                    </div>
                                    <p class="room-section-desc">同じ合言葉 (例: 123456 / room_a) を入力した端末同士で接続します</p>
                                    <div class="room-input-group">
                                        <input type="text" id="room-code-input" class="m3-text-input" placeholder="合言葉 (例: 123456) を入力...">
                                        <button id="btn-join-room" class="m3-button btn-secondary-sm" type="button">
                                            <span class="material-symbols-outlined">meeting_room</span> 接続
                                        </button>
                                    </div>
                                </div>

                                <!-- アクティブ接続待機ステータスカード -->
                                <div id="room-active-status" class="room-active-status hidden">
                                    <div class="room-status-info">
                                        <span class="material-symbols-outlined status-pulse">sensors</span>
                                        <span id="room-status-text">現在の合言葉: 123456 (相手の接続を待機中...)</span>
                                    </div>
                                    <button id="btn-leave-room" class="m3-icon-button-danger" title="切断" type="button">
                                        <span class="material-symbols-outlined">close</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- STEP 2: 接続完了・ファイル受送信画面（接続時のみ表示） -->
                    <div id="transfer-step-session" class="transfer-step-session hidden">
                        <!-- 接続中ヘッダーカード -->
                        <div class="session-connected-card">
                            <div class="session-info-group">
                                <span class="material-symbols-outlined session-connected-icon">swap_horizontal_circle</span>
                                <div>
                                    <div id="session-device-name" class="session-device-name">接続中: 相手端末</div>
                                    <div class="session-sub-text">双方向でファイルを何度でも送受信できます</div>
                                </div>
                            </div>
                            <button id="btn-disconnect-session" class="m3-icon-button-danger" title="切断" type="button">
                                <span class="material-symbols-outlined">link_off</span>
                            </button>
                        </div>

                        <!-- 相手の送信中ロック警告バナー -->
                        <div id="transfer-lock-banner" class="transfer-lock-banner hidden">
                            <span class="material-symbols-outlined">sync</span>
                            <span>相手端末がファイル送信中です。完了までお待ちください...</span>
                        </div>

                        <!-- ドロップゾーン -->
                        <div id="dropzone-area" class="dropzone-area">
                            <input type="file" id="file-input" class="hidden" multiple>
                            <div class="dropzone-content">
                                <span class="material-symbols-outlined dropzone-icon">upload_file</span>
                                <p class="dropzone-hint">クリックまたはドラッグ＆ドロップでファイルを選択</p>
                                <button id="btn-browse-files" class="m3-button btn-secondary-sm" type="button">
                                    <span class="material-symbols-outlined">folder_open</span> ファイルを選択
                                </button>
                            </div>
                        </div>

                        <!-- 送信ファイル待機エリア -->
                        <div id="staged-files-card" class="staged-files-card hidden">
                            <div class="staged-card-header">
                                <span class="staged-title">
                                    <span class="material-symbols-outlined">description</span>
                                    送信ファイル (<span id="staged-file-count">0</span>件)
                                </span>
                                <button id="btn-clear-staged" class="btn-text-danger" type="button">クリア</button>
                            </div>
                            <ul id="staged-file-list" class="staged-file-list"></ul>
                            <div class="staged-action-row">
                                <button id="btn-add-more-files" class="m3-button btn-secondary-sm" type="button">
                                    <span class="material-symbols-outlined">add</span> 追加
                                </button>
                                <button id="btn-start-send" class="m3-button btn-primary-lg" type="button">
                                    <span class="material-symbols-outlined">send</span> 送信開始
                                </button>
                            </div>
                        </div>

                        <!-- ゲストユーザー用 受信専用インフォバナー -->
                        <div id="guest-receiver-banner" class="guest-receiver-banner hidden">
                            <span class="material-symbols-outlined">downloading</span>
                            <span>ゲストモード（受信専用）<br>相手端末からファイルが届くと自動でダウンロードされます</span>
                        </div>

                        <!-- 受信・送信履歴 -->
                        <div class="transfers-history-card">
                            <h4><span class="material-symbols-outlined">history</span> 受信・送信履歴</h4>
                            <ul id="transfer-history-list" class="transfer-history-list">
                                <li class="empty-history">履歴はありません</li>
                            </ul>
                        </div>
                    </div>

                    <div id="transfer-progress-card" class="transfer-progress-card hidden">
                        <div class="progress-info-row">
                            <span id="transfer-filename" class="transfer-filename">filename.zip</span>
                            <span id="transfer-speed" class="transfer-speed">0.0 MB/s</span>
                        </div>
                        <div class="m3-progress-bar-bg">
                            <div id="transfer-progress-fill" class="m3-progress-bar-fill" style="width: 0%;"></div>
                        </div>
                        <div class="progress-sub-row">
                            <span id="transfer-status-label">転送中...</span>
                            <span id="transfer-percent">0%</span>
                        </div>
                    </div>
                </div>
            </main>

            <div id="date-display" class="date-display-floating hidden">--月--日</div>
            <div id="char-count" class="char-count-floating hidden">0 文字</div>
        </div>
    </div>

    <!-- ダイアログ群 -->
    <div id="delete-modal" class="modal-overlay hidden">
        <div class="m3-dialog">
            <div class="dialog-icon"><span class="material-symbols-outlined">delete_forever</span></div>
            <h3>メモを完全削除しますか？</h3>
            <p>この操作は元に戻せません。</p>
            <div class="dialog-actions">
                <button id="btn-delete-cancel" class="m3-text-button">キャンセル</button>
                <button id="btn-delete-confirm" class="m3-text-button btn-danger">削除</button>
            </div>
        </div>
    </div>

    <div id="empty-trash-modal" class="modal-overlay hidden">
        <div class="m3-dialog">
            <div class="dialog-icon"><span class="material-symbols-outlined">delete_sweep</span></div>
            <h3>ゴミ箱を空にしますか？</h3>
            <p>すべてのメモが永久に消去されます。</p>
            <div class="dialog-actions">
                <button id="btn-empty-cancel" class="m3-text-button">キャンセル</button>
                <button id="btn-empty-confirm" class="m3-text-button btn-danger">すべて削除</button>
            </div>
        </div>
    </div>

    <div id="logout-modal" class="modal-overlay hidden">
        <div class="m3-dialog">
            <div class="dialog-icon"><span class="material-symbols-outlined">logout</span></div>
            <h3>ログアウトの確認</h3>
            <p>本当にログアウトしますか？</p>
            <div class="dialog-actions">
                <button id="btn-modal-cancel" class="m3-text-button">キャンセル</button>
                <button id="btn-modal-confirm" class="m3-text-button btn-danger">ログアウト</button>
            </div>
        </div>
    </div>

    <!-- 設定モーダル -->
    <div id="settings-modal" class="modal-overlay hidden">
        <div class="m3-dialog settings-dialog-discord">
            <div class="dialog-header">
                <div class="dialog-title-group">
                    <span class="material-symbols-outlined" style="color:var(--m3-primary);">settings</span>
                    <h3>アプリ設定</h3>
                </div>
                <button id="btn-settings-close" class="m3-icon-button" title="閉じる">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <div class="discord-settings-layout">
                <nav class="settings-nav">
                    <button class="settings-tab-btn active" data-tab="account">
                        <span class="material-symbols-outlined">account_circle</span> アカウント
                    </button>
                    <button class="settings-tab-btn" data-tab="system">
                        <span class="material-symbols-outlined">tune</span> 一般・同期
                    </button>
                    <button class="settings-tab-btn" data-tab="about">
                        <span class="material-symbols-outlined">info</span> アプリ情報
                    </button>
                </nav>

                <div class="settings-content-area">
                    <div id="tab-content-account" class="tab-content">
                        <div class="discord-profile-card">
                            <div class="profile-banner"></div>
                            <div class="profile-header-content">
                                <img id="user-avatar" class="discord-avatar" src="" alt="">
                                <span id="user-provider-tag" class="provider-tag">Google</span>
                            </div>
                            <div class="profile-details">
                                <div id="user-name" class="profile-name">ユーザー</div>
                                <div id="user-email" class="profile-email">---</div>
                            </div>
                        </div>

                        <div class="setting-item-box" style="margin-top:1rem;">
                            <div class="setting-text">
                                <div id="settings-account-label" class="setting-label">アカウント管理</div>
                                <div id="settings-account-desc" class="setting-desc">別のアカウントへの切り替えまたはサインアウト</div>
                            </div>
                            <div style="display:flex; gap:0.5rem; align-items:center;">
                                <button id="btn-settings-switch-action" class="m3-button btn-secondary-sm" type="button">
                                    <span class="material-symbols-outlined" style="font-size:16px;">sync_alt</span> 切り替え
                                </button>
                                <button id="btn-settings-logout-action" class="m3-button btn-danger-sm" type="button">
                                    <span class="material-symbols-outlined" style="font-size:16px;">logout</span> ログアウト
                                </button>
                            </div>
                            <button id="btn-settings-login-action" class="m3-button btn-primary-sm hidden" type="button">
                                <span class="material-symbols-outlined" style="font-size:16px;">login</span> Googleでログイン
                            </button>
                        </div>
                    </div>

                    <div id="tab-content-system" class="tab-content hidden">
                        <div class="setting-item-box">
                            <div class="setting-text">
                                <div class="setting-label">リアルタイム同期</div>
                                <div class="setting-desc">1文字単位でリアルタイムにクラウドへ保存</div>
                            </div>
                            <span class="badge-active">有効</span>
                        </div>

                        <div class="setting-item-box">
                            <div class="setting-text">
                                <div class="setting-label">オフライン機能</div>
                                <div class="setting-desc">ネット未接続時もローカルに自動保持</div>
                            </div>
                            <span class="badge-active">有効</span>
                        </div>
                    </div>

                    <div id="tab-content-about" class="tab-content hidden">
                        <div class="setting-item-box">
                            <div class="setting-text">
                                <div class="setting-label">現在のバージョン</div>
                                <div class="setting-desc">ブラウザでロード中のコードバージョン</div>
                            </div>
                            <span id="app-version-display" class="version-badge">v...</span>
                        </div>

                        <p class="settings-desc" style="margin-top:0.8rem;">
                            ボタンを押すとキャッシュを全破棄して、常に最新の公開コードで再リロードします。
                        </p>
                        <button id="btn-update-check" class="m3-button btn-primary-full">
                            <span class="material-symbols-outlined">refresh</span> 更新を確認
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="toast-msg" class="m3-snackbar hidden">
        <span id="toast-text">メッセージ</span>
        <button id="btn-toast-action" class="snackbar-action hidden">元に戻す</button>
    </div>

    <script type="module" src="app.js"></script>
</body>

</html>
</file>

<file path="style.css">
:root {
    --m3-bg: #131314;
    --m3-surface: #1e1f20;
    --m3-surface-container: #28292a;
    --m3-surface-hover: #333537;
    --m3-border: #333537;
    --m3-primary: #a8c7fa;
    --m3-on-primary: #042f66;
    --m3-text: #e3e2e6;
    --m3-text-variant: #c4c6d0;
    --m3-text-muted: #8e918f;

    --m3-danger: #f28b82;
    --m3-danger-bg: #3c2424;
    --m3-danger-border: #5c3234;

    --m3-radius-sm: 8px;
    --m3-radius-md: 12px;
    --m3-radius-lg: 16px;
    --m3-radius-xl: 28px;
    --m3-radius-full: 9999px;
    --m3-motion-curve: cubic-bezier(0.2, 0, 0, 1);
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: 'Google Sans', sans-serif;
}

body,
html {
    height: 100%;
    height: 100dvh;
    background: var(--m3-bg);
    color: var(--m3-text);
    overflow: hidden;
}

/* ★ 邪魔なアローボタン（三角）を完全に削除 */
::-webkit-scrollbar-button {
    display: none !important;
    width: 0;
    height: 0;
}

/* ★ アプリ全域：幅6px、常に薄く表示されてホバーで濃くなる安定したスクロールバー */
::-webkit-scrollbar {
    width: 6px;
    height: 6px;
}

::-webkit-scrollbar-track {
    background: transparent;
}

::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.15);
    border-radius: var(--m3-radius-full);
    transition: background 0.2s ease;
}

::-webkit-scrollbar-thumb:hover,
::-webkit-scrollbar-thumb:active {
    background: rgba(255, 255, 255, 0.4) !important;
}

/* Firefox用 */
* {
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.15) transparent;
}

input,
textarea,
select {
    font-size: 16px !important;
}

.hidden {
    display: none !important;
}

.center-screen {
    display: flex;
    height: 100vh;
    height: 100dvh;
    justify-content: center;
    align-items: center;
    padding: 1rem;
}

.spinner-large {
    width: 32px;
    height: 32px;
    border: 3px solid var(--m3-border);
    border-top-color: var(--m3-primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
}

.spinner {
    width: 18px;
    height: 18px;
    border: 2px solid var(--m3-border);
    border-top-color: var(--m3-primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
}

@keyframes spin {
    to {
        transform: rotate(360deg);
    }
}

.m3-card {
    background: var(--m3-surface);
    border: 1px solid var(--m3-border);
    border-radius: var(--m3-radius-xl);
    padding: 2.2rem 1.8rem;
    width: 100%;
    max-width: 320px;
    text-align: center;
}

.brand-icon span {
    font-size: 44px;
    color: var(--m3-primary);
    margin-bottom: 0.5rem;
}

.m3-card h2 {
    font-size: 1.5rem;
    font-weight: 500;
    margin-bottom: 0.2rem;
}

.m3-card p {
    color: var(--m3-text-muted);
    font-size: 0.85rem;
    margin-bottom: 1.8rem;
}

.auth-buttons {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
}

.m3-button {
    width: 100%;
    padding: 0.8rem;
    border-radius: var(--m3-radius-full);
    border: 1px solid var(--m3-border);
    background: transparent;
    color: var(--m3-text);
    font-size: 0.88rem;
    font-weight: 500;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    transition: background 0.2s var(--m3-motion-curve);
}

.m3-button:hover {
    background: var(--m3-surface-hover);
}

.btn-google {
    background: #1a73e8;
    color: #fff;
    border: none;
}

.btn-google:hover {
    background: #1557b0;
}

.auth-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    color: var(--m3-primary);
    font-size: 0.9rem;
}

#app-container {
    display: flex;
    flex-direction: column;
    height: 100vh;
    height: 100dvh;
    position: relative;
}

.m3-top-app-bar {
    height: 52px;
    background: var(--m3-surface);
    border-bottom: 1px solid var(--m3-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1rem;
}

.header-left,
.header-right {
    display: flex;
    align-items: center;
    gap: 0.6rem;
}

.brand-logo {
    display: flex;
    align-items: center;
    gap: 0.4rem;
}

.brand-spark {
    color: var(--m3-primary);
    font-size: 20px;
}

.logo-text {
    font-size: 1rem;
    font-weight: 500;
}

.m3-badge {
    font-size: 0.72rem;
    color: var(--m3-text-muted);
    padding: 0.25rem 0.7rem;
    border-radius: var(--m3-radius-full);
    border: 1px solid var(--m3-border);
    background: var(--m3-surface-container);
    display: flex;
    align-items: center;
    gap: 0.4rem;
}

.status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    display: inline-block;
    background: #888;
}

.status-synced .status-dot {
    background: #81c995;
}

.status-saving .status-dot {
    background: #fdd663;
    animation: pulse 1s infinite alternate;
}

.status-offline .status-dot {
    background: #888;
}

@keyframes pulse {
    from {
        opacity: 0.4;
    }

    to {
        opacity: 1;
    }
}

.m3-icon-button {
    background: transparent;
    border: none;
    color: var(--m3-text-variant);
    cursor: pointer;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s var(--m3-motion-curve);
}

.m3-icon-button:hover:not(:disabled) {
    color: var(--m3-text);
    background: var(--m3-surface-hover);
}

.m3-icon-button.active {
    color: var(--m3-primary) !important;
    background: var(--m3-surface-container) !important;
    border: 1px solid var(--m3-primary);
}

.m3-icon-button:disabled {
    opacity: 0.3;
    cursor: not-allowed;
}

.main-layout {
    display: flex;
    flex: 1;
    overflow: hidden;
    position: relative;
}

.sidebar {
    width: 270px;
    background: var(--m3-surface);
    border-right: 1px solid var(--m3-border);
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.2s var(--m3-motion-curve);
    position: relative;
}

.sidebar-tabs {
    display: flex;
    border-bottom: 1px solid var(--m3-border);
    background: var(--m3-bg);
}

.tab-btn {
    flex: 1;
    padding: 0.6rem;
    background: transparent;
    border: none;
    color: var(--m3-text-muted);
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    transition: color 0.15s;
}

.tab-btn span {
    font-size: 16px;
}

.tab-btn.active {
    color: var(--m3-primary);
    border-bottom: 2px solid var(--m3-primary);
    background: var(--m3-surface);
}

.tab-btn#tab-trash.active {
    color: var(--m3-danger);
    border-bottom-color: var(--m3-danger);
}

.sidebar-top {
    padding: 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    border-bottom: 1px solid var(--m3-border);
}

.m3-search-bar {
    display: flex;
    align-items: center;
    background: var(--m3-bg);
    border: 1px solid var(--m3-border);
    border-radius: var(--m3-radius-full);
    padding: 0.4rem 0.8rem;
    gap: 0.5rem;
}

.m3-search-bar span {
    color: var(--m3-text-muted);
    font-size: 18px;
}

.m3-search-bar input {
    background: transparent;
    border: none;
    outline: none;
    color: var(--m3-text);
    width: 100%;
}

.m3-fab-button {
    width: 100%;
    padding: 0.75rem;
    border-radius: var(--m3-radius-lg);
    background: var(--m3-primary);
    color: var(--m3-on-primary);
    border: none;
    font-weight: 500;
    font-size: 0.88rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    transition: opacity 0.2s;
}

.m3-fab-button:hover {
    opacity: 0.9;
}

.btn-danger-fab {
    background: var(--m3-danger-bg);
    color: var(--m3-danger);
    border: 1px solid var(--m3-danger-border);
}

.btn-danger-fab:hover {
    background: #4a2b2b;
}

.list-container {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    position: relative;
}

.note-list {
    list-style: none;
    padding: 0.4rem 0.75rem 3.5rem 0.75rem;
}

.date-group-header {
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--m3-text-muted);
    padding: 0.6rem 0.4rem 0.2rem 0.4rem;
    letter-spacing: 0.3px;
    display: flex;
    align-items: center;
    gap: 0.3rem;
}

.note-item {
    padding: 0.8rem 1rem;
    border-radius: var(--m3-radius-md);
    margin-bottom: 0.35rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: background 0.15s;
    border-left: none !important;
    user-select: none;
}

.note-item:hover {
    background: var(--m3-surface-hover);
}

.note-item.active {
    background: var(--m3-surface-container);
}

.note-item.active .title {
    color: var(--m3-primary);
    font-weight: 500;
}

.note-item .item-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    overflow: hidden;
    pointer-events: none;
}

.note-item .title {
    font-size: 0.88rem;
    font-weight: 400;
    color: var(--m3-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: flex;
    align-items: center;
    gap: 0.3rem;
}

.note-item .sub-meta {
    font-size: 0.7rem;
    color: var(--m3-text-muted);
    font-family: 'Roboto Mono', monospace;
}

.pin-icon {
    font-size: 15px;
    color: var(--m3-primary);
}

.btn-delete {
    background: transparent;
    border: none;
    color: var(--m3-text-muted);
    opacity: 0;
    cursor: pointer;
    padding: 0.3rem;
    border-radius: 4px;
    display: flex;
    align-items: center;
    transition: opacity 0.15s;
    pointer-events: auto;
}

.note-item:hover .btn-delete {
    opacity: 1;
}

.btn-delete:hover {
    color: var(--m3-danger);
}

.empty-state {
    text-align: center;
    color: var(--m3-text-muted);
    font-size: 0.85rem;
    margin-top: 3rem;
}

.trash-bottom-banner {
    margin-top: auto;
    position: relative;
    background: var(--m3-danger-bg);
    border-top: 1px solid var(--m3-danger-border);
    z-index: 10;
}

.trash-fade-overlay {
    position: absolute;
    top: -24px;
    left: 0;
    right: 0;
    height: 24px;
    background: linear-gradient(to bottom, rgba(30, 31, 32, 0), var(--m3-surface));
    pointer-events: none;
}

.trash-banner-content {
    padding: 0.6rem 0.8rem;
    font-size: 0.72rem;
    color: var(--m3-danger);
    display: flex;
    align-items: center;
    gap: 0.4rem;
}

.trash-banner-content span {
    font-size: 15px;
}

/* Editor */
.editor-area {
    flex: 1;
    display: flex;
    flex-direction: column;
    background: var(--m3-bg);
    padding: 1rem 1.5rem;
    overflow-y: auto;
}

.editor-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--m3-border);
    margin-bottom: 0.8rem;
}

.toolbar-group {
    display: flex;
    align-items: center;
    gap: 0.4rem;
}

.m3-title-input {
    background: transparent;
    border: none;
    outline: none;
    color: var(--m3-text);
    font-size: 1.3rem;
    font-weight: 500;
    margin-bottom: 0.8rem;
    padding: 0.2rem 0;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
}

.m3-title-input:focus {
    border-bottom-color: var(--m3-border);
}

.m3-title-input::placeholder {
    color: var(--m3-text-muted);
    opacity: 0.5;
    font-weight: 400;
}

.m3-text-area {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: var(--m3-text);
    font-size: 1rem;
    resize: none;
    line-height: 1.7;
    font-family: 'Google Sans', 'Roboto Mono', sans-serif;
    padding-bottom: 100px !important;
}

.m3-code-view {
    flex: 1;
    overflow-y: auto;
    font-size: 1rem;
    line-height: 1.7;
    cursor: text;
    user-select: text;
    padding-bottom: 100px !important;
}

.m3-code-view p {
    margin-bottom: 0.8rem;
    white-space: pre-wrap;
    word-break: break-word;
}

.code-block-wrapper {
    background: #1e1f20;
    border: 1px solid var(--m3-border);
    border-radius: var(--m3-radius-md);
    margin: 0.8rem 0;
    overflow: hidden;
    transition: all 0.2s var(--m3-motion-curve);
}

.code-block-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--m3-surface-container);
    padding: 0.45rem 0.88rem;
    border-bottom: 1px solid var(--m3-border);
    font-size: 0.75rem;
    color: var(--m3-primary);
    font-family: 'Roboto Mono', monospace;
    font-weight: 500;
}

.code-header-actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
}

.code-header-btn {
    background: transparent;
    border: none;
    color: var(--m3-text-muted);
    cursor: pointer;
    font-size: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    transition: background 0.15s, color 0.15s;
}

.code-header-btn:hover {
    color: var(--m3-text);
    background: var(--m3-surface-hover);
}

.code-block-wrapper pre {
    margin: 0 !important;
    padding: 1rem !important;
    background: transparent !important;
    font-family: 'Roboto Mono', monospace !important;
    font-size: 0.9rem !important;
    line-height: 1.6 !important;
    overflow-x: auto;
}

.code-block-wrapper.is-collapsed pre {
    display: none !important;
}

.code-block-wrapper.is-collapsed {
    border-color: var(--m3-border);
}

.date-display-floating {
    position: absolute;
    bottom: 1.2rem;
    left: calc(270px + 1.5rem);
    font-size: 0.72rem;
    color: var(--m3-text-muted);
    background: var(--m3-surface);
    padding: 0.2rem 0.6rem;
    border-radius: var(--m3-radius-full);
    border: 1px solid var(--m3-border);
    pointer-events: none;
    opacity: 0.8;
    font-family: 'Roboto Mono', monospace;
    z-index: 10;
}

.char-count-floating {
    position: absolute;
    bottom: 1.2rem;
    right: 1.5rem;
    font-size: 0.72rem;
    color: var(--m3-text-muted);
    background: var(--m3-surface);
    padding: 0.2rem 0.6rem;
    border-radius: var(--m3-radius-full);
    border: 1px solid var(--m3-border);
    pointer-events: none;
    opacity: 0.8;
    font-family: 'Roboto Mono', monospace;
    z-index: 10;
}

/* Dialogs */
.modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
    padding: 1rem;
    backdrop-filter: blur(2px);
}

.m3-dialog {
    background: var(--m3-surface);
    border: 1px solid var(--m3-border);
    border-radius: var(--m3-radius-xl);
    padding: 1.4rem;
    width: 90vw;
    max-width: 290px;
    text-align: center;
}

.dialog-icon span {
    font-size: 28px;
    color: var(--m3-danger);
    margin-bottom: 0.3rem;
}

.m3-dialog h3 {
    font-size: 1.1rem;
    font-weight: 500;
    margin-bottom: 0.3rem;
}

.m3-dialog p {
    font-size: 0.82rem;
    color: var(--m3-text-muted);
    margin-bottom: 1.2rem;
    line-height: 1.4;
}

.dialog-actions {
    display: flex;
    gap: 0.6rem;
    justify-content: flex-end;
}

.m3-text-button {
    flex: 1;
    padding: 0.55rem;
    border-radius: var(--m3-radius-full);
    border: 1px solid var(--m3-border);
    background: transparent;
    color: var(--m3-text);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s;
}

.m3-text-button:hover {
    background: var(--m3-surface-hover);
}

.m3-text-button.btn-danger {
    background: var(--m3-danger-bg);
    color: var(--m3-danger);
    border: 1px solid var(--m3-danger-border);
}

.m3-text-button.btn-danger:hover {
    background: #4a2b2b;
}

/* Discordスタイル設定モーダル */
.settings-dialog-discord {
    max-width: 620px !important;
    width: 90vw;
    height: 480px;
    text-align: left;
    padding: 0 !important;
    overflow: hidden;
    display: flex;
    flex-direction: column;
}

.dialog-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.8rem 1.2rem;
    border-bottom: 1px solid var(--m3-border);
    background: var(--m3-surface-container);
}

.dialog-title-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.dialog-title-group h3 {
    font-size: 1rem;
    font-weight: 500;
}

.discord-settings-layout {
    display: flex;
    flex: 1;
    overflow: hidden;
}

.settings-nav {
    width: 160px;
    background: var(--m3-surface-container);
    border-right: 1px solid var(--m3-border);
    padding: 0.8rem 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    flex-shrink: 0;
}

.settings-tab-btn {
    background: transparent;
    border: none;
    color: var(--m3-text-muted);
    padding: 0.65rem 0.8rem;
    border-radius: var(--m3-radius-md);
    font-size: 0.82rem;
    font-weight: 500;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    transition: all 0.15s;
    text-align: left;
    width: 100%;
}

.settings-tab-btn span {
    font-size: 18px;
}

.settings-tab-btn:hover {
    background: var(--m3-surface-hover);
    color: var(--m3-text);
}

.settings-tab-btn.active {
    background: var(--m3-surface-hover);
    color: var(--m3-primary);
    font-weight: 500;
}

.settings-content-area {
    flex: 1;
    padding: 1.2rem 1.5rem;
    overflow-y: auto;
    background: var(--m3-bg);
}

.tab-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.discord-profile-card {
    background: var(--m3-surface);
    border-radius: var(--m3-radius-lg);
    border: 1px solid var(--m3-border);
    overflow: hidden;
    position: relative;
}

.profile-banner {
    height: 64px;
    background: linear-gradient(135deg, #042f66 0%, #1a73e8 100%);
}

.profile-header-content {
    padding: 0 1rem;
    margin-top: -26px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
}

.discord-avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 3px solid var(--m3-surface);
    background: var(--m3-surface-container);
    object-fit: cover;
}

.provider-tag {
    font-size: 0.7rem;
    background: var(--m3-surface-container);
    color: var(--m3-primary);
    padding: 0.2rem 0.6rem;
    border-radius: var(--m3-radius-full);
    border: 1px solid var(--m3-border);
    font-weight: 500;
}

.profile-details {
    padding: 0.8rem 1rem 1rem 1rem;
}

.profile-name {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--m3-text);
    margin-bottom: 0.1rem;
}

.profile-email {
    font-size: 0.78rem;
    color: var(--m3-text-muted);
    font-family: 'Roboto Mono', monospace;
}

.setting-item-box {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--m3-surface);
    padding: 0.8rem 1rem;
    border-radius: var(--m3-radius-md);
    border: 1px solid var(--m3-border);
}

.setting-label {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--m3-text);
}

.setting-desc {
    font-size: 0.72rem;
    color: var(--m3-text-muted);
}

.btn-danger-sm {
    background: var(--m3-danger-bg);
    color: var(--m3-danger);
    border: 1px solid var(--m3-danger-border);
    padding: 0.4rem 0.8rem;
    border-radius: var(--m3-radius-full);
    font-size: 0.8rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.3rem;
}

.badge-active {
    font-size: 0.72rem;
    background: #1c3829;
    color: #81c995;
    padding: 0.15rem 0.5rem;
    border-radius: var(--m3-radius-full);
    border: 1px solid #275237;
}

.version-badge {
    background: var(--m3-surface-container);
    padding: 0.2rem 0.6rem;
    border-radius: var(--m3-radius-full);
    border: 1px solid var(--m3-border);
    color: var(--m3-primary);
    font-size: 0.8rem;
}

.settings-desc {
    font-size: 0.78rem;
    color: var(--m3-text-muted);
    line-height: 1.4;
}

.btn-primary-full {
    width: 100%;
    background: var(--m3-primary);
    color: var(--m3-on-primary);
    border: none;
    font-weight: 500;
}

.m3-snackbar {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    background: var(--m3-surface-container);
    border: 1px solid var(--m3-border);
    color: var(--m3-text);
    padding: 0.65rem 1.1rem;
    border-radius: var(--m3-radius-md);
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.85rem;
    z-index: 90;
}

.snackbar-action {
    background: transparent;
    border: none;
    color: var(--m3-primary);
    font-weight: bold;
    cursor: pointer;
    font-size: 0.85rem;
}

@media (min-width: 769px) {

    #btn-back,
    .mobile-only {
        display: none !important;
    }
}

@media (max-width: 768px) {
    .sidebar {
        width: 100%;
        position: absolute;
        height: 100%;
        z-index: 2;
    }

    .editor-area {
        width: 100%;
        position: absolute;
        height: 100%;
        z-index: 1;
        padding: 1rem;
    }

    .btn-delete {
        opacity: 1;
    }

    .main-layout.view-editor .sidebar {
        transform: translateX(-100%);
    }

    .main-layout.view-editor .editor-area {
        z-index: 3;
    }

    .date-display-floating {
        left: 1.5rem;
    }

    .settings-dialog-discord {
        position: fixed;
        inset: 0;
        width: 100vw !important;
        height: 100dvh !important;
        max-width: 100vw !important;
        max-height: 100dvh !important;
        border-radius: 0 !important;
        border: none !important;
    }

    .discord-settings-layout {
        flex-direction: column;
    }

    .settings-nav {
        width: 100%;
        flex-direction: row;
        border-right: none;
        border-bottom: 1px solid var(--m3-border);
        padding: 0.4rem;
        overflow-x: auto;
    }

    .settings-tab-btn {
        flex: 1;
        justify-content: center;
        font-size: 0.78rem;
        padding: 0.5rem;
    }
}

/* Chrome拡張機能ポップアップ・サイドパネル最適化 */
body.is-extension-popup {
    width: 100%;
    height: 100vh;
    max-width: 800px;
    max-height: 600px;
}

@media (max-width: 480px) {
    body:not(.is-extension-popup) {
        width: 100%;
        height: 100%;
        height: -webkit-fill-available;
        height: 100dvh;
        max-height: none !important;
    }

    .date-display-floating {
        bottom: 0.5rem;
        font-size: 0.68rem;
    }

    .char-count-floating {
        bottom: 0.5rem;
        font-size: 0.68rem;
    }

    .m3-title-input {
        font-size: 1.1rem;
    }

    /* モバイル: 転送パネル最適化 */
    .session-connected-card {
        padding: 0.6rem 0.8rem;
    }

    .session-device-name {
        font-size: 0.82rem;
    }

    .session-sub-text {
        display: none; /* スマホでは補足テキスト非表示 */
    }

    .dropzone-area {
        padding: 1rem 0.8rem;
    }

    .dropzone-icon {
        font-size: 30px;
        margin-bottom: 0.2rem;
    }

    .dropzone-hint {
        font-size: 0.77rem;
    }

    .staged-card-header .staged-title {
        font-size: 0.82rem;
    }

    .staged-action-row {
        gap: 0.4rem;
    }

    .room-section-box {
        padding: 0.7rem 0.8rem;
    }

    .room-section-desc {
        font-size: 0.72rem;
    }
}

/* ==========================================================================
   ファイル送信 (DropZone 統合) & Material 3 カスタムドロップダウン スタイル
   ========================================================================== */

.main-layout.view-transfer .sidebar,
.main-layout.view-transfer .editor-toolbar,
.main-layout.view-transfer .m3-title-input,
.main-layout.view-transfer .m3-text-area,
.main-layout.view-transfer .m3-code-view {
    display: none !important;
}

.main-layout.view-transfer .editor-area {
    width: 100% !important;
    position: relative !important;
    transform: none !important;
    z-index: 10 !important;
    padding: 1rem;
}

.main-layout.view-transfer #transfer-panel {
    display: flex !important;
}

.transfer-panel {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    height: 100%;
    padding: 0.5rem 0.2rem;
    overflow-y: auto;
}

.transfer-header-card {
    background: var(--m3-surface);
    border: 1px solid var(--m3-border);
    border-radius: var(--m3-radius-lg);
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.transfer-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--m3-border);
}

.transfer-header-left {
    display: flex;
    align-items: center;
    gap: 0.8rem;
}

.transfer-top-bar h2 {
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--m3-primary);
    display: flex;
    align-items: center;
    gap: 0.4rem;
}

.btn-secondary-sm {
    background: var(--m3-surface-container);
    color: var(--m3-text);
    border: 1px solid var(--m3-border);
    padding: 0.4rem 0.9rem;
    border-radius: var(--m3-radius-full);
    font-size: 0.8rem;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    transition: all 0.2s ease;
}.transfer-mode-selector-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
}

.custom-dropdown-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--m3-text-muted);
    line-height: 1;
}

.custom-dropdown-label .material-symbols-outlined {
    font-size: 1.1rem;
    color: var(--m3-primary);
    line-height: 1;
    display: inline-block;
    vertical-align: middle;
}

/* ★ 100% 独自デザイン Material 3 カスタムドロップダウン */
.m3-custom-dropdown {
    position: relative;
    width: 100%;
}

.dropdown-trigger-btn {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--m3-surface-container);
    color: var(--m3-text);
    border: 1px solid var(--m3-border);
    border-radius: var(--m3-radius-md);
    padding: 0.75rem 1rem;
    font-size: 0.88rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s var(--m3-motion-curve);
    outline: none;
}

.dropdown-trigger-btn:hover {
    background: var(--m3-surface-hover);
    border-color: var(--m3-primary);
}

.selected-mode-text {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    line-height: 1;
}

.selected-mode-text .mode-icon {
    font-size: 1.15rem;
    color: var(--m3-primary);
    line-height: 1;
    display: inline-block;
    vertical-align: middle;
}

.dropdown-arrow {
    color: var(--m3-primary);
    transition: transform 0.2s ease;
}

.m3-custom-dropdown.open .dropdown-arrow {
    transform: rotate(180deg);
}

.dropdown-menu-list {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    width: 100%;
    background: #232427 !important;
    border: 1px solid #3c4043 !important;
