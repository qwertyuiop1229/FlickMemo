            <div class="dialog-actions">
                <button id="btn-empty-cancel" class="m3-text-button">キャンセル</button>
                <button id="btn-empty-confirm" class="m3-text-button btn-danger">すべて削除</button>
            </div>
        </div>
    </div>

    <div id="logout-modal" class="modal-overlay hidden">
