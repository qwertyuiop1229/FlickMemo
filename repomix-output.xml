<body>
    <div class="container">
        <div class="header-card">
            <div class="brand-icon-wrap">
                <img src="icon.png" alt="FlickMemo Icon">
            </div>
            <h1>FlickMemo for Chrome</h1>
            <p>ブラウザのサイドパネルでどこからでも開ける超軽量メモ帳＆最速ファイル転送</p>

            <div class="download-action-box">
                <a href="/flickmemo-extension.zip" download="flickmemo-extension.zip" class="btn-download-hero" id="btn-download-main">
                    <span class="material-symbols-outlined">download</span> 最新ZIPをダウンロード
                </a>
                <span class="version-tag" id="display-version">Version: 最新版</span>
            </div>
        </div>

        <div class="steps-section">
            <h2 class="section-title">
                <span class="material-symbols-outlined">install_desktop</span> インストール手順（約1分で完了）
            </h2>

            <div class="step-card">
                <div class="step-number">1</div>
                <div class="step-content">
                    <div class="step-title">最新ZIPファイルをダウンロードして解凍する</div>
                    <div class="step-desc">上のボタンから <code>flickmemo-extension.zip</code> をダウンロードし、右クリックして「すべて展開」等でフォルダを解凍してください。</div>
                </div>
            </div>

            <div class="step-card">
                <div class="step-number">2</div>
                <div class="step-content">
                    <div class="step-title">Chromeの拡張機能管理ページを開く</div>
                    <div class="step-desc">Chromeの新しいタブを開き、アドレスバーに以下のURLを入力して開きます。</div>
                    <div class="step-action-row">
                        <span class="code-snippet">chrome://extensions</span>
                        <button class="btn-primary-action-sm" id="btn-copy-ext-url" type="button">
                            <span class="material-symbols-outlined">content_copy</span> URLをコピー
                        </button>
                        <button class="btn-action-sm" id="btn-open-ext-tab" type="button">
                            <span class="material-symbols-outlined">open_in_new</span> 新しいタブで開く
                        </button>
                    </div>
                </div>
            </div>

            <div class="step-card">
                <div class="step-number">3</div>
                <div class="step-content">
                    <div class="step-title">「デベロッパーモード」をONにする</div>
                    <div class="step-desc">拡張機能ページの右上にある「デベロッパーモード」のトグルスイッチをクリックしてON（青色）にします。</div>
                </div>
            </div>

            <div class="step-card">
                <div class="step-number">4</div>
                <div class="step-content">
                    <div class="step-title">解凍したフォルダを読み込む</div>
                    <div class="step-desc">左上に表示される「<strong>パッケージ化されていない拡張機能を読み込む</strong>」ボタンを押し、Step 1で解凍したフォルダを選択します。</div>
                </div>
            </div>

            <div class="step-card">
                <div class="step-number">5</div>
                <div class="step-content">
                    <div class="step-title">完了！サイドパネルやショートカットで即座に起動</div>
                    <div class="step-desc">拡張機能アイコンをクリックするとブラウザ右側にサイドパネルとして常駐します。<br>ショートカット <code>Ctrl+Shift+M</code>（Macは <code>Cmd+Shift+M</code>）でも瞬時に開けます。</div>
                </div>
            </div>
        </div>

        <div class="footer-nav">
            <a href="/" class="btn-action-sm">
                <span class="material-symbols-outlined">arrow_back</span> Web版アプリに戻る
            </a>
        </div>
    </div>

    <div id="toast" class="toast-msg">
        <span class="material-symbols-outlined" style="font-size:18px; color:var(--m3-primary);">check_circle</span>
        <span id="toast-text">メッセージ</span>
    </div>

    <script>
        function showToast(text) {
            const toast = document.getElementById('toast');
            const toastText = document.getElementById('toast-text');
            toastText.textContent = text;
            toast.classList.add('show');
            setTimeout(() => toast.classList.remove('show'), 3500);
        }

        // 最新バージョン表示
        fetch('/version.json?t=' + Date.now())
            .then(res => res.json())
            .then(data => {
                if (data && data.version) {
                    document.getElementById('display-version').textContent = 'Version: v' + data.version;
                }
            })
            .catch(() => {});

        // chrome://extensions コピー
        document.getElementById('btn-copy-ext-url').onclick = () => {
            navigator.clipboard.writeText('chrome://extensions').then(() => {
                showToast('「chrome://extensions」をコピーしました！新しいタブに貼り付けてください');
            });
        };

        // 新しいタブで開く試行
        document.getElementById('btn-open-ext-tab').onclick = () => {
            navigator.clipboard.writeText('chrome://extensions');
            try {
                const w = window.open('chrome://extensions', '_blank');
                if (!w || w.closed || typeof w.closed === 'undefined') {
                    showToast('URLをコピーしました！新しいタブのアドレスバーに貼り付けてください');
                } else {
                    showToast('拡張機能ページを開きました');
                }
            } catch (e) {
                showToast('URLをコピーしました！新しいタブのアドレスバーに貼り付けてください');
            }
        };
    </script>
</body>

</html>
