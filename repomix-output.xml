    line-height: 1;
}

.custom-dropdown-label .material-symbols-outlined {
    font-size: 1.1rem;
    color: var(--m3-primary);
    line-height: 1;
    display: inline-block;
    vertical-align: middle;
}

/* ★ 100% 独自デザイン Material 3 カスタムドロップダウン */
.m3-custom-dropdown {
    position: relative;
    width: 100%;
}

.dropdown-trigger-btn {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--m3-surface-container);
    color: var(--m3-text);
    border: 1px solid var(--m3-border);
    border-radius: var(--m3-radius-md);
    padding: 0.75rem 1rem;
    font-size: 0.88rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s var(--m3-motion-curve);
    outline: none;
}

.dropdown-trigger-btn:hover {
    background: var(--m3-surface-hover);
    border-color: var(--m3-primary);
}

.selected-mode-text {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    line-height: 1;
}

.selected-mode-text .mode-icon {
    font-size: 1.15rem;
    color: var(--m3-primary);
    line-height: 1;
    display: inline-block;
    vertical-align: middle;
}

.dropdown-arrow {
    color: var(--m3-primary);
    transition: transform 0.2s ease;
}

.m3-custom-dropdown.open .dropdown-arrow {
    transform: rotate(180deg);
}

.dropdown-menu-list {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    width: 100%;
    background: #232427 !important;
    border: 1px solid #3c4043 !important;
    border-radius: var(--m3-radius-md);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.85) !important;
    z-index: 1000;
    overflow: hidden;
    list-style: none;
    padding: 0.4rem 0;
    opacity: 1 !important;
    animation: fadeInDown 0.15s ease-out;
}

@keyframes fadeInDown {
    from {
        opacity: 0;
        transform: translateY(-6px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* STEP 1: 接続先選択画面 */
.transfer-step-connect {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

/* 送信先セグメントタブ */
.target-segmented-tabs {
    display: flex;
    background: var(--m3-surface-container-high);
    border-radius: var(--m3-radius-full);
    padding: 0.25rem;
    gap: 0.25rem;
    border: 1px solid var(--m3-border);
    margin-top: 0.4rem;
}

.target-tab-btn {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    background: transparent;
    border: none;
    color: var(--m3-text-muted);
    padding: 0.5rem 1rem;
    border-radius: var(--m3-radius-full);
    font-size: 0.82rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
}

.target-tab-btn:hover {
    color: var(--m3-text);
}

.target-tab-btn.active {
    background: var(--m3-surface);
    color: var(--m3-primary);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
}

.target-panel-content {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
}

.room-action-container {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
}

.room-section-box {
    background: var(--m3-surface-container);
    border: 1px solid var(--m3-border);
    border-radius: var(--m3-radius-md);
    padding: 0.9rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.room-section-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--m3-primary);
}

.room-section-desc {
    font-size: 0.76rem;
    color: var(--m3-text-muted);
    margin: 0;
}

.room-divider-badge {
    text-align: center;
    position: relative;
    margin: 0.2rem 0;
}

.room-divider-badge:before {
    content: "";
    position: absolute;
    top: 50%; left: 0; right: 0;
    height: 1px;
    background: var(--m3-border);
    z-index: 1;
}

.room-divider-badge span {
    position: relative;
    z-index: 2;
    background: var(--m3-surface);
    padding: 0 0.8rem;
    font-size: 0.72rem;
    color: var(--m3-text-muted);
}

.room-input-group {
    display: flex;
    gap: 0.5rem;
}

.full-width {
    width: 100%;
    justify-content: center;
}

.m3-text-input {
    flex: 1;
    background: var(--m3-surface);
    border: 1px solid var(--m3-border);
    border-radius: var(--m3-radius-md);
    padding: 0.5rem 0.8rem;
    color: var(--m3-text);
    font-size: 0.82rem;
    outline: none;
}

.m3-text-input:focus {
    border-color: var(--m3-primary);
}

.m3-icon-button-danger {
    background: transparent;
    border: none;
    color: var(--m3-danger);
    width: 32px;
    height: 32px;
    border-radius: var(--m3-radius-full);
    display: inline-flex;
    align-items: center;
    justify-content: center;
