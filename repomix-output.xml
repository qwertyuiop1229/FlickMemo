    transition: background 0.2s ease;
}

.m3-icon-button-danger:hover {
    background: rgba(234, 67, 53, 0.15);
}

.room-active-status {
    background: rgba(43, 114, 219, 0.15);
    border: 1px solid var(--m3-primary);
    border-radius: var(--m3-radius-md);
    padding: 0.8rem 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.6rem;
}

.room-status-info {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.82rem;
    color: var(--m3-primary);
    font-weight: 500;
    flex: 1;
    min-width: 0;
}

.room-status-details {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
}

.room-status-title {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--m3-primary);
