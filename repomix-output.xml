    50% { opacity: 1; }
    100% { opacity: 0.4; }
}

.dropdown-menu-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    cursor: pointer;
    transition: background 0.15s ease;
}

.dropdown-menu-item:hover {
    background: var(--m3-surface-hover);
}

.dropdown-menu-item.selected {
    background: rgba(168, 199, 250, 0.12);
    color: var(--m3-primary);
}

.item-text-group {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex: 1;
}

.item-title {
    font-size: 0.88rem;
    font-weight: 500;
}

.item-desc {
    font-size: 0.72rem;
    color: var(--m3-text-muted);
}

.check-icon {
    font-size: 18px !important;
    color: var(--m3-primary) !important;
}

.btn-text-subtle {
    background: transparent;
    border: none;
    color: var(--m3-text-muted);
    font-size: 0.78rem;
    cursor: pointer;
    text-decoration: underline;
    margin-top: 0.8rem;
    transition: color 0.2s ease;
}

.btn-text-subtle:hover {
    color: var(--m3-text);
}

.e2ee-toggle-card {
    background: var(--m3-surface-container);
    border: 1px solid var(--m3-border);
    border-radius: var(--m3-radius-md);
    padding: 0.6rem 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.e2ee-label-group {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--m3-primary);
}

.m3-switch {
    position: relative;
    display: inline-block;
    width: 36px;
    height: 20px;
}

.m3-switch input {
    opacity: 0;
    width: 0;
    height: 0;
}

.m3-switch-slider {
    position: absolute;
    cursor: pointer;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: var(--m3-border);
    transition: .3s;
    border-radius: 20px;
}

.m3-switch-slider:before {
    position: absolute;
    content: "";
    height: 14px;
    width: 14px;
    left: 3px;
    bottom: 3px;
    background-color: var(--m3-text);
    transition: .3s;
    border-radius: 50%;
}

.m3-switch input:checked + .m3-switch-slider {
