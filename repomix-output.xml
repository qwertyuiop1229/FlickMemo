    border: none;
    color: var(--m3-primary);
    font-weight: bold;
    cursor: pointer;
    font-size: 0.85rem;
}

@media (min-width: 769px) {

    #btn-back,
    .mobile-only {
        display: none !important;
    }
}

@media (max-width: 768px) {
    .sidebar {
        width: 100%;
        position: absolute;
        height: 100%;
        z-index: 2;
    }

    .editor-area {
        width: 100%;
        position: absolute;
        height: 100%;
