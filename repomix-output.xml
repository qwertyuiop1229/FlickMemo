    <link rel="stylesheet" href="style.css">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">
</head>

<body>

    <div id="splash-screen" class="center-screen">
        <div class="spinner-large"></div>
    </div>

    <div id="auth-container" class="center-screen hidden">
        <div class="m3-card auth-card">
            <div class="brand-icon">
                <span class="material-symbols-outlined">edit_note</span>
            </div>
            <h2>FlickMemo</h2>
            <p>即座に書ける、超軽量メモ帳</p>

            <div id="auth-loading" class="auth-loading hidden">
                <div class="spinner"></div>
                <span>ログイン中...</span>
            </div>

            <div id="auth-buttons" class="auth-buttons">
                <button id="btn-google" class="m3-button btn-google">
                    <span class="material-symbols-outlined">login</span> Google でログイン
                </button>
                <button id="btn-guest-login" class="btn-text-subtle" type="button">
                    ログインせずに使う (オフラインメモ / 共有リンク送受信)
                </button>
            </div>
        </div>
    </div>

    <div id="app-container" class="hidden">
        <header class="m3-top-app-bar">
            <div class="header-left">
                <button id="btn-back-transfer" class="m3-icon-button hidden" title="メモに戻る">
                    <span class="material-symbols-outlined">arrow_back</span>
                </button>
                <button id="btn-back" class="m3-icon-button mobile-only hidden" title="一覧に戻る">
                    <span class="material-symbols-outlined">arrow_back</span>
                </button>
                <div class="brand-logo">
                    <span class="material-symbols-outlined brand-spark">auto_awesome</span>
                    <span class="logo-text">FlickMemo</span>
                </div>
            </div>

            <div class="header-right">
                <div id="status-bar" class="m3-badge status-synced">
                    <span class="status-dot"></span>
                    <span id="status-text">同期完了</span>
                </div>
                <button id="btn-header-transfer" class="m3-icon-button" title="最速ファイル送信">
                    <span class="material-symbols-outlined">send_and_archive</span>
                </button>
                <button id="btn-settings-trigger" class="m3-icon-button" title="設定">
                    <span class="material-symbols-outlined">settings</span>
                </button>
            </div>
        </header>

        <div class="main-layout" id="main-layout">
            <aside class="sidebar" id="sidebar-container">
                <div class="sidebar-tabs">
                    <button id="tab-notes" class="tab-btn active">
                        <span class="material-symbols-outlined">description</span> メモ
                    </button>
                    <button id="tab-trash" class="tab-btn">
                        <span class="material-symbols-outlined">delete</span> ゴミ箱
                    </button>
                </div>

                <div class="sidebar-top">
                    <div class="m3-search-bar">
                        <span class="material-symbols-outlined">search</span>
                        <input type="text" id="search-input" placeholder="検索... (Ctrl+F)">
                    </div>
                    <button id="btn-new" class="m3-fab-button">
                        <span class="material-symbols-outlined">add</span> 新しいメモ
                    </button>
                    <button id="btn-empty-trash" class="m3-fab-button btn-danger-fab hidden">
                        <span class="material-symbols-outlined">delete_sweep</span> ゴミ箱を空にする
                    </button>
                </div>

                <div class="list-container" id="list-container">
                    <ul id="note-list" class="note-list"></ul>
                    <div id="empty-state" class="empty-state hidden">メモがありません</div>
                </div>

                <div id="trash-notice" class="trash-bottom-banner hidden">
                    <div class="trash-fade-overlay"></div>
                    <div class="trash-banner-content">
                        <span class="material-symbols-outlined">info</span>
                        <span>ゴミ箱のメモは7日後に自動消去されます</span>
                    </div>
                </div>
            </aside>

            <main class="editor-area" id="editor-area">
                <div class="editor-toolbar hidden" id="editor-toolbar">
                    <div class="toolbar-group">
                        <button id="btn-undo" class="m3-icon-button" title="元に戻す (Undo)" disabled>
                            <span class="material-symbols-outlined">undo</span>
                        </button>
                        <button id="btn-redo" class="m3-icon-button" title="やり直す (Redo)" disabled>
                            <span class="material-symbols-outlined">redo</span>
                        </button>
                    </div>

                    <div class="toolbar-group">
                        <button id="btn-pin" class="m3-icon-button" title="ピン留め">
                            <span class="material-symbols-outlined">push_pin</span>
                        </button>
                        <button id="btn-trash-indicator" class="m3-icon-button active hidden" title="ゴミ箱内のメモ（閲覧のみ）"
                            style="color:var(--m3-danger) !important; border-color:var(--m3-danger-border) !important; cursor:default;">
                            <span class="material-symbols-outlined">delete</span>
                        </button>
                        <button id="btn-copy" class="m3-icon-button" title="コピー">
                            <span class="material-symbols-outlined">content_copy</span>
                        </button>
                        <button id="btn-restore-trash" class="m3-icon-button hidden" title="ゴミ箱から復元">
                            <span class="material-symbols-outlined">restore_from_trash</span>
                        </button>
                    </div>
                </div>

                <input type="text" id="note-title-input" class="m3-title-input hidden" placeholder="タイトル（未入力時は自動抽出）"
                    disabled>

                <textarea id="note-body" class="m3-text-area" placeholder="メモを入力..." disabled></textarea>

                <div id="note-code-view" class="m3-code-view hidden"></div>

                <!-- ファイル送信・受信用全画面パネル -->
                <div id="transfer-panel" class="transfer-panel hidden">
                    <div class="transfer-header-card">
                        <div class="transfer-top-bar">
                            <div class="transfer-header-left">
                                <h2><span class="material-symbols-outlined">send_and_archive</span> ファイル送信</h2>
                            </div>
                        </div>
                        <div class="transfer-mode-selector-group">
                            <label class="custom-dropdown-label">
                                <span class="material-symbols-outlined">bolt</span> 送信モードを選択
                            </label>
                            <!-- 100% 独自デザイン Material 3 カスタムドロップダウン -->
                            <div class="m3-custom-dropdown" id="custom-mode-dropdown">
                                <button type="button" class="dropdown-trigger-btn" id="dropdown-trigger">
                                    <span id="selected-mode-text" class="selected-mode-text">
                                        <span class="material-symbols-outlined mode-icon">auto_awesome</span> 自動判別（スマート最適化）
                                    </span>
                                    <span class="material-symbols-outlined dropdown-arrow">expand_more</span>
                                </button>
                                <ul class="dropdown-menu-list hidden" id="dropdown-menu-list">
                                    <li class="dropdown-menu-item selected" data-value="AUTO">
                                        <span class="material-symbols-outlined">auto_awesome</span>
                                        <div class="item-text-group">
                                            <span class="item-title">自動判別（スマート最適化）</span>
                                            <span class="item-desc">ネットワーク環境やファイルサイズを自動解析して最適化</span>
                                        </div>
                                        <span class="material-symbols-outlined check-icon">check</span>
                                    </li>
                                    <li class="dropdown-menu-item" data-value="LAN_P2P">
                                        <span class="material-symbols-outlined">bolt</span>
                                        <div class="item-text-group">
                                            <span class="item-title">同一Wi-Fi / LAN WebRTC P2P</span>
                                            <span class="item-desc">同一ネットワーク内・サーバー中継なし・回線速度上限</span>
                                        </div>
                                        <span class="material-symbols-outlined check-icon hidden">check</span>
                                    </li>
                                    <li class="dropdown-menu-item" data-value="WAN_P2P">
                                        <span class="material-symbols-outlined">public</span>
                                        <div class="item-text-group">
                                            <span class="item-title">インターネット P2P (STUN)</span>
                                            <span class="item-desc">別Wi-Fi / 4G / 5G同士のダイレクト通信</span>
                                        </div>
                                        <span class="material-symbols-outlined check-icon hidden">check</span>
                                    </li>
                                    <li class="dropdown-menu-item" data-value="WEB_RELAY">
                                        <span class="material-symbols-outlined">hub</span>
                                        <div class="item-text-group">
                                            <span class="item-title">Webリレイパイプ (E2EE/通信量0)</span>
                                            <span class="item-desc">P2P遮断環境・厳重プロキシ対応・暗号化リアルタイム中継</span>
                                        </div>
                                        <span class="material-symbols-outlined check-icon hidden">check</span>
                                    </li>
                                    
                                </ul>
                            </div>
                        </div>

                    <!-- STEP 1: 接続先選択・接続画面 -->
                    <div id="transfer-step-connect" class="transfer-step-connect">
                        <!-- ★ 送信先選択 セグメントタブ -->
                        <div class="target-segmented-tabs">
                            <button id="btn-target-tab-devices" class="target-tab-btn active" type="button">
                                <span class="material-symbols-outlined">devices</span> マイデバイス
                            </button>
                            <button id="btn-target-tab-room" class="target-tab-btn" type="button">
                                <span class="material-symbols-outlined">link</span> 共有リンクで接続
                            </button>
                        </div>

                        <!-- 1. マイデバイスパネル -->
                        <div id="target-panel-devices" class="target-panel-content">
                            <div id="device-chip-list" class="device-chip-list">
                                <span class="no-device-text">他デバイスを検索中...</span>
                            </div>
                        </div>

                        <!-- 2. 共有リンクパネル -->
                        <div id="target-panel-room" class="target-panel-content hidden">
                            <div class="room-action-container">
                                <!-- 共有リンク発行セクション -->
                                <div id="room-create-section" class="room-section-box">
                                    <div class="room-section-header">
                                        <span class="material-symbols-outlined">link</span>
                                        <span>ワンタップ共有リンクを発行</span>
                                    </div>
                                    <p class="room-section-desc">発行されたリンクを相手に送るだけで、ログイン不要＆暗号化ダイレクトP2P接続で双方向ファイル送受信を開始できます。</p>
                                    <button id="btn-create-room" class="m3-button btn-primary-sm full-width" type="button">
                                        <span class="material-symbols-outlined">add_link</span> 共有リンクを発行してコピー
                                    </button>
                                </div>

                                <!-- 共有リンク待機ステータスカード -->
                                <div id="room-active-status" class="room-active-status hidden">
                                    <div class="room-status-info">
                                        <span class="material-symbols-outlined status-pulse">sensors</span>
                                        <div class="room-status-details">
                                            <span class="room-status-title">共有リンク待機中 (相手の参加を待っています)</span>
                                            <span id="room-status-url" class="room-status-url">https://...</span>
                                        </div>
                                    </div>
                                    <div class="room-status-actions">
                                        <button id="btn-recopy-room" class="m3-icon-button" title="URLを再コピー" type="button">
                                            <span class="material-symbols-outlined">content_copy</span>
                                        </button>
                                        <button id="btn-leave-room" class="m3-icon-button-danger" title="共有を停止" type="button">
                                            <span class="material-symbols-outlined">close</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- STEP 2: 接続完了・ファイル受送信画面（接続時のみ表示） -->
                    <div id="transfer-step-session" class="transfer-step-session hidden">
                        <!-- 接続中ヘッダーカード -->
                        <div class="session-connected-card">
                            <div class="session-info-group">
                                <span class="material-symbols-outlined session-connected-icon">swap_horizontal_circle</span>
                                <div>
                                    <div id="session-device-name" class="session-device-name">接続中: 相手端末</div>
                                    <div class="session-sub-text">双方向でファイルを何度でも送受信できます</div>
                                </div>
                            </div>
                            <button id="btn-disconnect-session" class="m3-icon-button-danger" title="切断" type="button">
                                <span class="material-symbols-outlined">link_off</span>
                            </button>
                        </div>

                        <!-- ★ 接続セッション内 E2EE 暗号化トグル -->
                        <div class="e2ee-toggle-card" style="margin-top: 0.75rem; margin-bottom: 0.75rem;">
                            <div class="e2ee-label-group">
                                <span class="material-symbols-outlined">lock</span>
                                <span>AES-256 E2EE暗号化</span>
                            </div>
                            <label class="m3-switch">
                                <input type="checkbox" id="toggle-session-e2ee" checked>
                                <span class="m3-switch-slider"></span>
                            </label>
                        </div>

                        <!-- 相手の送信中ロック警告バナー -->
                        <div id="transfer-lock-banner" class="transfer-lock-banner hidden">
                            <span class="material-symbols-outlined">sync</span>
                            <span>相手端末がファイル送信中です。完了までお待ちください...</span>
                        </div>

                        <!-- ドロップゾーン -->
                        <div id="dropzone-area" class="dropzone-area">
                            <input type="file" id="file-input" class="hidden" multiple>
                            <div class="dropzone-content">
                                <span class="material-symbols-outlined dropzone-icon">upload_file</span>
                                <p class="dropzone-hint">クリックまたはドラッグ＆ドロップでファイルを選択</p>
                                <button id="btn-browse-files" class="m3-button btn-secondary-sm" type="button">
                                    <span class="material-symbols-outlined">folder_open</span> ファイルを選択
                                </button>
                            </div>
                        </div>

                        <!-- 送信ファイル待機エリア -->
                        <div id="staged-files-card" class="staged-files-card hidden">
                            <div class="staged-card-header">
                                <span class="staged-title">
                                    <span class="material-symbols-outlined">description</span>
