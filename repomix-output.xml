                                </span>
                                <button id="btn-clear-staged" class="btn-text-danger" type="button">クリア</button>
                            </div>
                            <ul id="staged-file-list" class="staged-file-list"></ul>
                            <div class="staged-action-row">
                                <button id="btn-add-more-files" class="m3-button btn-secondary-sm" type="button">
                                    <span class="material-symbols-outlined">add</span> 追加
                                </button>
                                <button id="btn-start-send" class="m3-button btn-primary-lg" type="button">
                                    <span class="material-symbols-outlined">send</span> 送信開始
                                </button>
                            </div>
                        </div>

                        <!-- ゲストユーザー用 受信専用インフォバナー -->
                        <div id="guest-receiver-banner" class="guest-receiver-banner hidden">
                            <span class="material-symbols-outlined">downloading</span>
                            <span>ゲストモード（受信専用）<br>相手端末からファイルが届くと自動でダウンロードされます</span>
                        </div>

                        <!-- 受信・送信履歴 -->
                        <div class="transfers-history-card">
                            <h4><span class="material-symbols-outlined">history</span> 受信・送信履歴</h4>
                            <ul id="transfer-history-list" class="transfer-history-list">
                                <li class="empty-history">履歴はありません</li>
                            </ul>
                        </div>
                    </div>

                    <div id="transfer-progress-card" class="transfer-progress-card hidden">
                        <div class="progress-info-row">
                            <span id="transfer-filename" class="transfer-filename">filename.zip</span>
                            <span id="transfer-speed" class="transfer-speed">0.0 MB/s</span>
                        </div>
                        <div class="m3-progress-bar-bg">
                            <div id="transfer-progress-fill" class="m3-progress-bar-fill" style="width: 0%;"></div>
                        </div>
                        <div class="progress-sub-row">
                            <span id="transfer-status-label">転送中...</span>
                            <span id="transfer-percent">0%</span>
                        </div>
                    </div>
                </div>
            </main>

            <div id="date-display" class="date-display-floating hidden">--月--日</div>
            <div id="char-count" class="char-count-floating hidden">0 文字</div>
        </div>
    </div>

    <!-- ダイアログ群 -->
    <div id="delete-modal" class="modal-overlay hidden">
        <div class="m3-dialog">
            <div class="dialog-icon"><span class="material-symbols-outlined">delete_forever</span></div>
            <h3>メモを完全削除しますか？</h3>
