        min-width: fit-content;
        justify-content: center;
        font-size: 0.82rem;
        padding: 0.6rem 0.9rem;
        border-radius: 12px;
        white-space: nowrap !important;
        word-break: keep-all !important;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .settings-tab-btn.active {
        background: var(--m3-primary);
        color: #ffffff;
        font-weight: 600;
        border-color: transparent;
    }

    .settings-content-area {
        padding: 1rem;
    }

    .setting-item-box {
        flex-direction: column;
        align-items: stretch;
        gap: 0.9rem;
        padding: 1rem 1.1rem;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .setting-item-box > div:last-child {
        width: 100%;
        display: flex;
        gap: 0.6rem;
        justify-content: stretch;
    }

    #btn-settings-switch-action,
    #btn-settings-logout-action,
    #btn-settings-login-action {
        flex: 1;
        justify-content: center;
        padding: 0.65rem 0.8rem;
        font-size: 0.85rem;
        white-space: nowrap !important;
        word-break: keep-all !important;
        border-radius: 12px;
    }

    .developer-toolbar {
        flex-direction: column;
        align-items: stretch;
        gap: 0.75rem;
    }

    .dev-actions {
        width: 100%;
        display: flex;
        gap: 0.6rem;
    }

    #btn-dev-copy-all,
    #btn-dev-clear-logs {
        flex: 1;
        justify-content: center;
        white-space: nowrap !important;
        word-break: keep-all !important;
        padding: 0.65rem;
        font-size: 0.82rem;
        border-radius: 12px;
    }

    .dev-filter-bar {
        overflow-x: auto;
        scrollbar-width: none;
        padding-bottom: 0.2rem;
    }

    .dev-filter-bar::-webkit-scrollbar {
        display: none;
    }

    .dev-filter-btn {
        white-space: nowrap !important;
        word-break: keep-all !important;
        flex-shrink: 0;
        padding: 0.45rem 0.8rem;
        font-size: 0.78rem;
        border-radius: 10px;
    }
}

/* Chrome拡張機能ポップアップ・サイドパネル最適化 */
body.is-extension-popup {
    width: 100%;
    height: 100vh;
    max-width: 800px;
    max-height: 600px;
}

@media (max-width: 480px) {
    body:not(.is-extension-popup) {
        width: 100%;
        height: 100%;
        height: -webkit-fill-available;
        height: 100dvh;
        max-height: none !important;
    }

    .date-display-floating {
        bottom: 0.5rem;
        font-size: 0.68rem;
    }

    .char-count-floating {
        bottom: 0.5rem;
        font-size: 0.68rem;
    }

    .m3-title-input {
        font-size: 1.1rem;
    }

    /* モバイル: 転送パネル最適化 */
    .session-connected-card {
        padding: 0.6rem 0.8rem;
    }

    .session-device-name {
        font-size: 0.82rem;
    }

    .session-sub-text {
        display: none; /* スマホでは補足テキスト非表示 */
    }

    .dropzone-area {
        padding: 1rem 0.8rem;
    }

    .dropzone-icon {
        font-size: 30px;
        margin-bottom: 0.2rem;
    }

    .dropzone-hint {
        font-size: 0.77rem;
    }

    .staged-card-header .staged-title {
        font-size: 0.82rem;
    }

    .staged-action-row {
        gap: 0.4rem;
    }

    .room-section-box {
        padding: 0.7rem 0.8rem;
    }

    .room-section-desc {
        font-size: 0.72rem;
    }
}

/* ==========================================================================
   ファイル送信 (DropZone 統合) & Material 3 カスタムドロップダウン スタイル
   ========================================================================== */

.main-layout.view-transfer .sidebar,
.main-layout.view-transfer .editor-toolbar,
.main-layout.view-transfer .m3-title-input,
.main-layout.view-transfer .m3-text-area,
.main-layout.view-transfer .m3-code-view {
