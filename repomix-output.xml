    --m3-danger: #f28b82;
    --m3-danger-bg: #3c2424;
    --m3-danger-border: #5c3234;

    --m3-radius-sm: 8px;
    --m3-radius-md: 12px;
    --m3-radius-lg: 16px;
    --m3-radius-xl: 28px;
    --m3-radius-full: 9999px;
    --m3-motion-curve: cubic-bezier(0.2, 0, 0, 1);
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: 'Google Sans', sans-serif;
}

body,
html {
    height: 100%;
    height: 100dvh;
    background: var(--m3-bg);
    color: var(--m3-text);
    overflow: hidden;
}

/* ★ 邪魔なアローボタン（三角）を完全に削除 */
::-webkit-scrollbar-button {
    display: none !important;
    width: 0;
    height: 0;
}

/* ★ アプリ全域：幅6px、常に薄く表示されてホバーで濃くなる安定したスクロールバー */
::-webkit-scrollbar {
    width: 6px;
    height: 6px;
}

::-webkit-scrollbar-track {
    background: transparent;
}

::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.15);
    /* 常に薄く見えるためドラッグしやすい */
    border-radius: var(--m3-radius-full);
    transition: background 0.2s ease;
}

::-webkit-scrollbar-thumb:hover,
::-webkit-scrollbar-thumb:active {
    background: rgba(255, 255, 255, 0.4) !important;
}

/* Firefox用 */
* {
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.15) transparent;
}

input,
textarea,
select {
    font-size: 16px !important;
}

.hidden {
    display: none !important;
}

.center-screen {
    display: flex;
    height: 100vh;
    height: 100dvh;
    justify-content: center;
    align-items: center;
    padding: 1rem;
}

.spinner-large {
    width: 32px;
    height: 32px;
    border: 3px solid var(--m3-border);
    border-top-color: var(--m3-primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
}

.spinner {
    width: 18px;
    height: 18px;
    border: 2px solid var(--m3-border);
    border-top-color: var(--m3-primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
}

@keyframes spin {
    to {
        transform: rotate(360deg);
    }
}

.m3-card {
    background: var(--m3-surface);
    border: 1px solid var(--m3-border);
    border-radius: var(--m3-radius-xl);
    padding: 2.2rem 1.8rem;
    width: 100%;
    max-width: 320px;
    text-align: center;
}

.brand-icon span {
    font-size: 44px;
    color: var(--m3-primary);
    margin-bottom: 0.5rem;
}

.m3-card h2 {
    font-size: 1.5rem;
    font-weight: 500;
    margin-bottom: 0.2rem;
}

.m3-card p {
    color: var(--m3-text-muted);
    font-size: 0.85rem;
    margin-bottom: 1.8rem;
}

.auth-buttons {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
}

.m3-button {
    width: 100%;
    padding: 0.8rem;
    border-radius: var(--m3-radius-full);
    border: 1px solid var(--m3-border);
    background: transparent;
    color: var(--m3-text);
    font-size: 0.88rem;
    font-weight: 500;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    transition: background 0.2s var(--m3-motion-curve);
}

.m3-button:hover {
    background: var(--m3-surface-hover);
}

.btn-google {
    background: #1a73e8;
    color: #fff;
    border: none;
}

.btn-google:hover {
    background: #1557b0;
}

.auth-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    color: var(--m3-primary);
    font-size: 0.9rem;
}

#app-container {
    display: flex;
    flex-direction: column;
    height: 100vh;
    height: 100dvh;
    position: relative;
}

.m3-top-app-bar {
    height: 52px;
    background: var(--m3-surface);
    border-bottom: 1px solid var(--m3-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1rem;
}

.header-left,
.header-right {
    display: flex;
    align-items: center;
    gap: 0.6rem;
}

.brand-logo {
    display: flex;
    align-items: center;
    gap: 0.4rem;
}

.brand-spark {
    color: var(--m3-primary);
    font-size: 20px;
}

.logo-text {
    font-size: 1rem;
    font-weight: 500;
}

.m3-badge {
    font-size: 0.72rem;
    color: var(--m3-text-muted);
    padding: 0.25rem 0.7rem;
    border-radius: var(--m3-radius-full);
    border: 1px solid var(--m3-border);
    background: var(--m3-surface-container);
    display: flex;
    align-items: center;
    gap: 0.4rem;
}

.status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    display: inline-block;
    background: #888;
}

.status-synced .status-dot {
    background: #81c995;
}

.status-saving .status-dot {
    background: #fdd663;
    animation: pulse 1s infinite alternate;
}

.status-offline .status-dot {
    background: #888;
}

@keyframes pulse {
    from {
        opacity: 0.4;
    }

    to {
        opacity: 1;
    }
}

.m3-icon-button {
    background: transparent;
    border: none;
    color: var(--m3-text-variant);
    cursor: pointer;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s var(--m3-motion-curve);
}

.m3-icon-button:hover:not(:disabled) {
    color: var(--m3-text);
    background: var(--m3-surface-hover);
}

.m3-icon-button.active {
    color: var(--m3-primary) !important;
    background: var(--m3-surface-container) !important;
    border: 1px solid var(--m3-primary);
}

.m3-icon-button:disabled {
    opacity: 0.3;
    cursor: not-allowed;
}

.main-layout {
    display: flex;
    flex: 1;
    overflow: hidden;
    position: relative;
}

.sidebar {
    width: 270px;
    background: var(--m3-surface);
    border-right: 1px solid var(--m3-border);
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.2s var(--m3-motion-curve);
    position: relative;
}

.sidebar-tabs {
    display: flex;
    border-bottom: 1px solid var(--m3-border);
    background: var(--m3-bg);
}

.tab-btn {
    flex: 1;
    padding: 0.6rem;
    background: transparent;
    border: none;
    color: var(--m3-text-muted);
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    transition: color 0.15s;
}

.tab-btn span {
    font-size: 16px;
}

.tab-btn.active {
    color: var(--m3-primary);
    border-bottom: 2px solid var(--m3-primary);
    background: var(--m3-surface);
}

.tab-btn#tab-trash.active {
    color: var(--m3-danger);
    border-bottom-color: var(--m3-danger);
}

.sidebar-top {
    padding: 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    border-bottom: 1px solid var(--m3-border);
}

.m3-search-bar {
    display: flex;
    align-items: center;
    background: var(--m3-bg);
    border: 1px solid var(--m3-border);
    border-radius: var(--m3-radius-full);
    padding: 0.4rem 0.8rem;
    gap: 0.5rem;
}

.m3-search-bar span {
    color: var(--m3-text-muted);
    font-size: 18px;
}

.m3-search-bar input {
    background: transparent;
    border: none;
    outline: none;
    color: var(--m3-text);
    width: 100%;
}

.m3-fab-button {
    width: 100%;
    padding: 0.75rem;
    border-radius: var(--m3-radius-lg);
    background: var(--m3-primary);
    color: var(--m3-on-primary);
    border: none;
    font-weight: 500;
    font-size: 0.88rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    transition: opacity 0.2s;
}

.m3-fab-button:hover {
    opacity: 0.9;
}

.btn-danger-fab {
    background: var(--m3-danger-bg);
    color: var(--m3-danger);
    border: 1px solid var(--m3-danger-border);
}

.btn-danger-fab:hover {
    background: #4a2b2b;
}

.list-container {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    position: relative;
}

.note-list {
    list-style: none;
    padding: 0.4rem 0.75rem 3.5rem 0.75rem;
}

.date-group-header {
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--m3-text-muted);
    padding: 0.6rem 0.4rem 0.2rem 0.4rem;
    letter-spacing: 0.3px;
    display: flex;
    align-items: center;
    gap: 0.3rem;
}

.note-item {
    padding: 0.8rem 1rem;
    border-radius: var(--m3-radius-md);
    margin-bottom: 0.35rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: background 0.15s;
    border-left: none !important;
    user-select: none;
}

.note-item:hover {
    background: var(--m3-surface-hover);
}

.note-item.active {
    background: var(--m3-surface-container);
}

.note-item.active .title {
    color: var(--m3-primary);
    font-weight: 500;
}

.note-item .item-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    overflow: hidden;
    pointer-events: none;
}

.note-item .title {
    font-size: 0.88rem;
    font-weight: 400;
    color: var(--m3-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: flex;
    align-items: center;
    gap: 0.3rem;
}

.note-item .sub-meta {
    font-size: 0.7rem;
    color: var(--m3-text-muted);
    font-family: 'Roboto Mono', monospace;
}

.pin-icon {
    font-size: 15px;
    color: var(--m3-primary);
}

.btn-delete {
    background: transparent;
    border: none;
    color: var(--m3-text-muted);
    opacity: 0;
    cursor: pointer;
    padding: 0.3rem;
    border-radius: 4px;
    display: flex;
    align-items: center;
    transition: opacity 0.15s;
    pointer-events: auto;
}

.note-item:hover .btn-delete {
    opacity: 1;
}

.btn-delete:hover {
    color: var(--m3-danger);
}

.empty-state {
    text-align: center;
    color: var(--m3-text-muted);
    font-size: 0.85rem;
    margin-top: 3rem;
}

.trash-bottom-banner {
    margin-top: auto;
    position: relative;
    background: var(--m3-danger-bg);
    border-top: 1px solid var(--m3-danger-border);
    z-index: 10;
}

.trash-fade-overlay {
    position: absolute;
    top: -24px;
    left: 0;
    right: 0;
    height: 24px;
    background: linear-gradient(to bottom, rgba(30, 31, 32, 0), var(--m3-surface));
    pointer-events: none;
}

.trash-banner-content {
    padding: 0.6rem 0.8rem;
    font-size: 0.72rem;
    color: var(--m3-danger);
    display: flex;
    align-items: center;
    gap: 0.4rem;
}

.trash-banner-content span {
    font-size: 15px;
}

/* Editor */
/* ★ .editor-area 自体は position: relative を外すか、バッジを外の main-layout に追従させる */
.editor-area {
    flex: 1;
    display: flex;
    flex-direction: column;
    background: var(--m3-bg);
    padding: 1rem 1.5rem;
    overflow-y: auto;
}

.editor-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--m3-border);
    margin-bottom: 0.8rem;
}

.toolbar-group {
    display: flex;
    align-items: center;
    gap: 0.4rem;
}

.m3-title-input {
    background: transparent;
    border: none;
    outline: none;
    color: var(--m3-text);
    font-size: 1.3rem;
    font-weight: 500;
    margin-bottom: 0.8rem;
    padding: 0.2rem 0;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
}

.m3-title-input:focus {
    border-bottom-color: var(--m3-border);
}

.m3-title-input::placeholder {
    color: var(--m3-text-muted);
    opacity: 0.5;
    font-weight: 400;
}

/* ★ 文字被りを100%防止するための超巨大な余白 */
.m3-text-area {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: var(--m3-text);
    font-size: 1rem;
    resize: none;
    line-height: 1.7;
    font-family: 'Google Sans', 'Roboto Mono', sans-serif;
    padding-bottom: 100px !important;
}

.m3-code-view {
    flex: 1;
    overflow-y: auto;
    font-size: 1rem;
    line-height: 1.7;
    cursor: text;
    user-select: text;
    padding-bottom: 100px !important;
}

.m3-code-view p {
    margin-bottom: 0.8rem;
    white-space: pre-wrap;
    word-break: break-word;
}

.code-block-wrapper {
    background: #1e1f20;
    border: 1px solid var(--m3-border);
    border-radius: var(--m3-radius-md);
    margin: 0.8rem 0;
    overflow: hidden;
    transition: all 0.2s var(--m3-motion-curve);
}

.code-block-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--m3-surface-container);
    padding: 0.45rem 0.88rem;
    border-bottom: 1px solid var(--m3-border);
    font-size: 0.75rem;
    color: var(--m3-primary);
    font-family: 'Roboto Mono', monospace;
    font-weight: 500;
}

.code-header-actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
}

.code-header-btn {
    background: transparent;
    border: none;
    color: var(--m3-text-muted);
    cursor: pointer;
    font-size: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    transition: background 0.15s, color 0.15s;
}

.code-header-btn:hover {
    color: var(--m3-text);
    background: var(--m3-surface-hover);
}

.code-block-wrapper pre {
    margin: 0 !important;
    padding: 1rem !important;
    background: transparent !important;
    font-family: 'Roboto Mono', monospace !important;
    font-size: 0.9rem !important;
    line-height: 1.6 !important;
    overflow-x: auto;
}

.code-block-wrapper.is-collapsed pre {
    display: none !important;
}

.code-block-wrapper.is-collapsed {
    border-color: var(--m3-border);
}

/* ★ バッジをスクロールコンテナ外（.main-layout）の右下・左下に完全固定（被りなし） */
.date-display-floating {
    position: absolute;
    bottom: 1.2rem;
    left: calc(270px + 1.5rem);
    font-size: 0.72rem;
    color: var(--m3-text-muted);
    background: var(--m3-surface);
    padding: 0.2rem 0.6rem;
    border-radius: var(--m3-radius-full);
    border: 1px solid var(--m3-border);
    pointer-events: none;
    opacity: 0.8;
    font-family: 'Roboto Mono', monospace;
    z-index: 10;
}

.char-count-floating {
    position: absolute;
    bottom: 1.2rem;
    right: 1.5rem;
    font-size: 0.72rem;
    color: var(--m3-text-muted);
    background: var(--m3-surface);
    padding: 0.2rem 0.6rem;
    border-radius: var(--m3-radius-full);
    border: 1px solid var(--m3-border);
    pointer-events: none;
    opacity: 0.8;
    font-family: 'Roboto Mono', monospace;
    z-index: 10;
}

/* Dialogs */
.modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
    padding: 1rem;
    backdrop-filter: blur(2px);
}

.m3-dialog {
    background: var(--m3-surface);
    border: 1px solid var(--m3-border);
    border-radius: var(--m3-radius-xl);
    padding: 1.4rem;
    width: 90vw;
    max-width: 290px;
    text-align: center;
}

.dialog-icon span {
    font-size: 28px;
    color: var(--m3-danger);
    margin-bottom: 0.3rem;
}

.m3-dialog h3 {
    font-size: 1.1rem;
    font-weight: 500;
    margin-bottom: 0.3rem;
}

.m3-dialog p {
    font-size: 0.82rem;
    color: var(--m3-text-muted);
    margin-bottom: 1.2rem;
    line-height: 1.4;
}

.dialog-actions {
    display: flex;
    gap: 0.6rem;
    justify-content: flex-end;
}

.m3-text-button {
    flex: 1;
    padding: 0.55rem;
    border-radius: var(--m3-radius-full);
    border: 1px solid var(--m3-border);
    background: transparent;
    color: var(--m3-text);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s;
}

.m3-text-button:hover {
    background: var(--m3-surface-hover);
}

.m3-text-button.btn-danger {
    background: var(--m3-danger-bg);
    color: var(--m3-danger);
    border: 1px solid var(--m3-danger-border);
}

.m3-text-button.btn-danger:hover {
    background: #4a2b2b;
}

/* Discordスタイル設定モーダル */
.settings-dialog-discord {
    max-width: 620px !important;
    width: 90vw;
    height: 480px;
    text-align: left;
    padding: 0 !important;
    overflow: hidden;
    display: flex;
    flex-direction: column;
}

.dialog-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.8rem 1.2rem;
    border-bottom: 1px solid var(--m3-border);
    background: var(--m3-surface-container);
}

.dialog-title-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.dialog-title-group h3 {
    font-size: 1rem;
    font-weight: 500;
}

.discord-settings-layout {
    display: flex;
    flex: 1;
    overflow: hidden;
}

.settings-nav {
    width: 160px;
    background: var(--m3-surface-container);
    border-right: 1px solid var(--m3-border);
    padding: 0.8rem 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    flex-shrink: 0;
}

.settings-tab-btn {
    background: transparent;
    border: none;
    color: var(--m3-text-muted);
    padding: 0.65rem 0.8rem;
    border-radius: var(--m3-radius-md);
    font-size: 0.82rem;
    font-weight: 500;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    transition: all 0.15s;
    text-align: left;
    width: 100%;
}

.settings-tab-btn span {
    font-size: 18px;
}

.settings-tab-btn:hover {
    background: var(--m3-surface-hover);
    color: var(--m3-text);
}

.settings-tab-btn.active {
    background: var(--m3-surface-hover);
    color: var(--m3-primary);
    font-weight: 500;
}

.settings-content-area {
    flex: 1;
    padding: 1.2rem 1.5rem;
    overflow-y: auto;
    background: var(--m3-bg);
}

.tab-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.discord-profile-card {
    background: var(--m3-surface);
    border-radius: var(--m3-radius-lg);
    border: 1px solid var(--m3-border);
    overflow: hidden;
    position: relative;
}

.profile-banner {
    height: 64px;
    background: linear-gradient(135deg, #042f66 0%, #1a73e8 100%);
}

.profile-header-content {
    padding: 0 1rem;
    margin-top: -26px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
}

.discord-avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 3px solid var(--m3-surface);
    background: var(--m3-surface-container);
    object-fit: cover;
}

.provider-tag {
    font-size: 0.7rem;
    background: var(--m3-surface-container);
    color: var(--m3-primary);
    padding: 0.2rem 0.6rem;
    border-radius: var(--m3-radius-full);
    border: 1px solid var(--m3-border);
    font-weight: 500;
}

.profile-details {
    padding: 0.8rem 1rem 1rem 1rem;
}

.profile-name {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--m3-text);
    margin-bottom: 0.1rem;
}

.profile-email {
    font-size: 0.78rem;
    color: var(--m3-text-muted);
    font-family: 'Roboto Mono', monospace;
}

.setting-item-box {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--m3-surface);
    padding: 0.8rem 1rem;
    border-radius: var(--m3-radius-md);
    border: 1px solid var(--m3-border);
}

.setting-label {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--m3-text);
}

.setting-desc {
    font-size: 0.72rem;
