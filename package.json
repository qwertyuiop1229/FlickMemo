{
    "name": "flickmemo",
    "version": "1.3.81",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "deploy": "node bump.js && npm run check && git add . && git commit -m \"auto deploy: update code and version\" && git push --set-upstream origin HEAD && firebase deploy --only hosting",
        "test": "node --experimental-vm-modules --test",
        "check": "npm test && npm run build && npm run verify-build",
        "verify-build": "node scripts/verify-build.mjs",
        "test:browser": "node scripts/verify-transfer-browser.mjs",
        "dev:desktop": "tauri dev",
        "dev:desktop:web": "vite --host 127.0.0.1 --port 5175 --strictPort",
        "build:desktop": "vite build --config vite.desktop.config.js",
        "package:windows": "tauri build",
        "check:windows": "node scripts/check-windows-environment.mjs"
    },
    "dependencies": {
        "@tauri-apps/api": "^2.12.4",
        "firebase": "12.6.0",
        "jszip": "^3.10.1",
        "prismjs": "^1.30.0"
    },
    "devDependencies": {
        "@tauri-apps/cli": "^2.12.4",
        "fake-indexeddb": "^6.2.6",
        "jsdom": "^26.1.0",
        "playwright-core": "^1.64.1",
        "vite": "^8.3.5"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "overrides": {
        "@grpc/grpc-js": "^1.13.6"
    }
}
