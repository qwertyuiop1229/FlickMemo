{
    "name": "flickmemo",
    "version": "1.3.78",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "deploy": "node bump.js && npm run check && git add . && git commit -m \"auto deploy: update code and version\" && git push --set-upstream origin HEAD && firebase deploy --only hosting",
        "test": "node --experimental-vm-modules --test",
        "check": "npm test && npm run build && npm run verify-build",
        "verify-build": "node scripts/verify-build.mjs"
    },
    "dependencies": {
        "firebase": "12.6.0",
        "jszip": "^3.10.1",
        "prismjs": "^1.30.0"
    },
    "devDependencies": {
        "fake-indexeddb": "^6.2.6",
        "jsdom": "^26.1.0",
        "vite": "^8.3.5"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "overrides": {
        "@grpc/grpc-js": "^1.13.6"
    }
}