{
    "manifest_version": 3,
    "name": "FlickMemo - 超軽量リアルタイムメモ帳",
    "version": "1.3.42",
    "description": "即座に書ける、リアルタイム同期の超軽量メモ帳＆最速ファイル送信",
    "key": "",
    "action": {
        "default_title": "FlickMemoをサイドパネルで開く"
    },
    "side_panel": {
        "default_path": "index.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "oauth2": {
        "client_id": "998795111125-0or2js8p7848ht26va94deqhphtrv2o1.apps.googleusercontent.com",
        "scopes": [
            "email",
            "profile",
            "openid"
        ]
    },
    "permissions": [
        "sidePanel",
        "identity",
        "storage",
        "contextMenus",
        "tabs",
        "windows"
    ],
    "omnibox": {
        "keyword": "fm"
    },
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "default": "Ctrl+Shift+M",
                "mac": "Command+Shift+M"
            },
            "description": "FlickMemoを開く"
        }
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self';"
    }
}